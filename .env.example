# Optional: Set a PostgreSQL URL if you wish to use an external PostgreSQL database (e.g. Neon, Supabase, local Postgres).
# If left empty or omitted, the application automatically runs zero-setup embedded SQLite/PGlite persisted in ./.data/quiz-db
DATABASE_URL=

# Optional: Add an LLM API key to enable AI-powered MCQ generation from study notes or topics.
# (If not provided, the application uses its built-in rule-based generator)
GEMINI_API_KEY=
# or
OPENAI_API_KEY=
